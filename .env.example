# ─────────────────────────────────────────────────────────────
# تنظیمات محیط — پس از استخراج بسته، این فایل را به .env کپی کنید.
# مقدار پیش‌فرض زیر بدون تغییر روی ویندوز/لینوکس/مک کار می‌کند.
# ─────────────────────────────────────────────────────────────
# نکته: مسیرهای نسبی در Prisma نسبت به پوشهٔ prisma تفسیر می‌شوند؛
# بنابراین شکل صحیح نسبی «../db» است نه «./db».
# مثال — مسیر مطلق در ویندوز (به‌جای \ از / استفاده کنید):
# DATABASE_URL="file:C:/medical-device-mes/db/custom.db"
# مثال — مسیر مطلق در لینوکس/مک:
# DATABASE_URL="file:/home/USER/medical-device-mes/db/custom.db"
DATABASE_URL="file:../db/custom.db"
